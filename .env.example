# Shared
TELEGRAM_BOT_TOKEN=123456789:replace-me
DATABASE_URL=postgresql://pricewatch:pricewatch@postgres:5432/pricewatch

# Vercel Telegram webhook
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Docker-only local PostgreSQL defaults
POSTGRES_DB=pricewatch
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=change-this-password

# Worker / GitHub Actions
SCAN_INTERVAL_SECONDS=240
WORKER_BATCH_SIZE=20
LEASE_SECONDS=180
MARKETPLACE_TIMEOUT_SECONDS=20
OUTBOX_BATCH_SIZE=50
# WORKER_ID can be omitted; host/container/run-specific value is used.
# WORKER_ID=pricewatch-worker-1

# Legacy long-polling runtime only
TELEGRAM_POLL_TIMEOUT=30
